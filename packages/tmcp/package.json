{
	"name": "tmcp",
	"version": "1.20.0",
	"description": "The main tmcp library",
	"main": "src/index.js",
	"type": "module",
	"types": "./types/index.d.ts",
	"scripts": {
		"test": "vitest",
		"typecheck": "tsc --noEmit",
		"generate:types": "generate-types && publint",
		"prepublish": "pnpm generate:types"
	},
	"keywords": [],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/paoloricciuti/tmcp.git",
		"directory": "packages/tmcp"
	},
	"author": "Paolo Ricciuti",
	"license": "MIT",
	"files": [
		"src/",
		"types/",
		"!src/**/*.d.ts"
	],
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./src/index.js"
		},
		"./tool": {
			"types": "./types/tool.d.ts",
			"default": "./src/tool.js"
		},
		"./prompt": {
			"types": "./types/prompt.d.ts",
			"default": "./src/prompt.js"
		},
		"./resource": {
			"types": "./types/resource.d.ts",
			"default": "./src/resource.js"
		},
		"./template": {
			"types": "./types/template.d.ts",
			"default": "./src/template.js"
		},
		"./adapter": {
			"types": "./types/adapter.d.ts",
			"default": "./src/adapter.js"
		},
		"./method-policy": {
			"types": "./types/method-policy.d.ts",
			"default": "./src/method-policy.js"
		},
		"./utils": {
			"types": "./types/utils/index.d.ts",
			"default": "./src/utils/index.js"
		},
		"./package.json": "./package.json"
	},
	"typesVersions": {
		"*": {
			"tool": [
				"./types/tool.d.ts"
			],
			"prompt": [
				"./types/prompt.d.ts"
			],
			"resource": [
				"./types/resource.d.ts"
			],
			"template": [
				"./types/template.d.ts"
			],
			"adapter": [
				"./types/adapter.d.ts"
			],
			"method-policy": [
				"./types/method-policy.d.ts"
			],
			"utils": [
				"./types/utils/index.d.ts"
			]
		}
	},
	"dependencies": {
		"@standard-schema/spec": "^1.0.0",
		"@types/json-schema": "^7.0.15",
		"json-rpc-2.0": "^1.7.1",
		"sqids": "^0.3.0",
		"uri-template-matcher": "^1.1.1",
		"valibot": "^1.1.0"
	},
	"devDependencies": {
		"@tmcp/internal-ts-helpers": "workspace:^",
		"@types/node": "^24.0.13",
		"publint": "^0.3.12",
		"vitest": "^4.0.0"
	}
}
