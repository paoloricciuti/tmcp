{
	"name": "@tmcp/transport-http",
	"version": "0.9.0",
	"license": "MIT",
	"description": "Transport for TMCP using HTTP",
	"type": "module",
	"main": "src/index.js",
	"types": "./types/index.d.ts",
	"scripts": {
		"generate:types": "generate-types && publint",
		"prepublish": "pnpm generate:types",
		"test": "vitest --run"
	},
	"exports": {
		".": {
			"types": "./types/index.d.ts",
			"default": "./src/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"src/**/*",
		"types/**/*",
		"!src/**/*.d.ts"
	],
	"peerDependencies": {
		"tmcp": "^1.20.0-next.0 || ^1.20.0",
		"@tmcp/auth": "^0.3.3 || ^0.4.0 || ^0.5.0-next.0"
	},
	"peerDependenciesMeta": {
		"@tmcp/auth": {
			"optional": true
		}
	},
	"keywords": [
		"tmcp",
		"http",
		"transport"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/paoloricciuti/tmcp.git",
		"directory": "packages/transport-http"
	},
	"dependencies": {
		"@tmcp/session-manager": "workspace:^",
		"esm-env": "^1.2.2"
	},
	"devDependencies": {
		"@modelcontextprotocol/sdk": "^1.17.1",
		"@remix-run/node-fetch-server": "^0.13.0",
		"@tmcp/adapter-valibot": "workspace:^",
		"@tmcp/auth": "workspace:^",
		"@tmcp/internal-ts-helpers": "workspace:^",
		"@types/node": "^24.0.15",
		"publint": "^0.3.12",
		"tmcp": "workspace:^",
		"valibot": "^1.1.0",
		"vitest": "^4.0.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
